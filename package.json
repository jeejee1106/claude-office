{
  "name": "claude-office-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter @claude-office/server start",
    "office": "pnpm --filter @claude-office/web build && pnpm --filter @claude-office/collector build && node packages/collector/dist/claude-office.js",
    "replay": "pnpm --filter @claude-office/server start --replay fixtures/sample-session.jsonl",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "typescript": "~6.0.3"
  }
}
